{
  "name": "boomboom-news",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.4",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"ENABLE_SWAGGER=1 bun --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "server": "bun server/index.ts",
    "start": "bun server/index.ts",
    "build": "tsc -b && vite build",
    "test": "bun test ./**/*.test.ts",
    "lint": "eslint src server shared",
    "format": "prettier --write \"server/**/*.ts\" \"shared/**/*.ts\" \"src/hooks/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"server/**/*.ts\" \"shared/**/*.ts\" \"src/hooks/**/*.ts\" \"docs/**/*.md\"",
    "preview": "vite preview --host 0.0.0.0",
    "openapi:emit": "bun server/openapiEmit.ts",
    "openapi:client": "openapi-typescript openapi.json -o src/generated/api-types.ts",
    "openapi": "bun run openapi:emit && bun run openapi:client",
    "audit": "bun audit --ignore GHSA-mh99-v99m-4gvg",
    "worker:optimize": "bun server/optimizeWorker.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "@tailwindcss/vite": "4.2.4",
    "elysia": "1.4.28",
    "ml-matrix": "^6.12.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "tailwindcss": "4.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@eslint/js": "^9.39.1",
    "@types/bun": "1.3.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "10.0.4",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.6.1",
    "prettier": "3.5.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "8.1.5"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  }
}
